<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting
         when the OS's Dark Mode setting is on.
         Uses Theme.Light.NoTitleBar to keep the startup window white,
         matching the Flutter splash background even in dark mode.

         Android 12+ windowSplashScreen* attributes prevent the launcher
         icon from appearing as the system splash on dark-mode devices.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Pre-Android 12 window background (plain white, no logo) -->
        <item name="android:windowBackground">@drawable/launch_background</item>

        <!-- Android 12+ System Splash Screen configuration for dark mode.
             windowSplashScreenAnimatedIcon points to launch_background (white
             drawable) — invisible on white background, preventing launcher icon. -->
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
