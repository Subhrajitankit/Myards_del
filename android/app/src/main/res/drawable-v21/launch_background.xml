<?xml version="1.0" encoding="utf-8"?>
<!-- Launch background for API 21+ (Android 5.0+) that visually matches
     the Flutter SplashScreen first frame.
     @mipmap/ic_launcher was generated from dp_logo2.png (same as Images.logo),
     so native and Flutter splash look identical — seamless transition. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White background — same as Flutter splash Scaffold background -->
    <item android:drawable="@color/background_color" />

    <!-- Centered app logo — same image as Images.logo (dp_logo2.png) -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>